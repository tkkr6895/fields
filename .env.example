# Field Validator App - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# CORESTACK API CONFIGURATION
# =============================================================================
# Your CoreStack API key - obtain from https://core-stack.org/use-apis/
VITE_CORESTACK_API_KEY=

# =============================================================================
# GOOGLE EARTH ENGINE CONFIGURATION (Optional - for Dynamic World)
# =============================================================================
# Your GEE project ID
GEE_PROJECT=

# Port for the Dynamic World proxy server
PORT=8787

# Optional: Service account JSON for production deployments
# Keep on one line, escape newlines in private_key with \\n
# GEE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
