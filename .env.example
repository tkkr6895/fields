# Fields — environment template
# Copy to `.env`. Never commit `.env`.

# CoRE Stack — https://core-stack.org/use-apis/
VITE_CORESTACK_API_KEY=

# Google Earth Engine proxy (Dynamic World + IndiaSAT tiles/points)
GEE_PROJECT=
PORT=8787
VITE_DW_GEE_PROXY_URL=http://localhost:8787
# GEE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional Tessera embedding sampler (python3 server/tessera-proxy.py)
TESSERA_PORT=8788
VITE_TESSERA_PROXY_URL=http://localhost:8788
